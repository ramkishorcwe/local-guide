# Public frontend identifiers. Keep any actual API keys WITHOUT a VITE_ prefix.
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id
VITE_APPWRITE_DATABASE_ID=local-guide
VITE_APPWRITE_COLLECTION_ID=pois
VITE_APPWRITE_TRIPS_COLLECTION_ID=trips
VITE_APPWRITE_BOOKING_COLLECTION_ID=bookings

# Server only. Used by the local API, Vercel API, or Appwrite Function.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Seed-only server key; requires documents.write (POI reads are public).
# Never expose it as VITE_APP_WRITE_API_KEY.
APPWRITE_API_KEY=

# Seed script only: existing Appwrite admin credentials, or a server API key.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
