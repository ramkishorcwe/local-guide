{
  "name": "local-guide",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"tsx watch server/dev.ts\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "tsx --test tests/planner.test.ts tests/sse.test.ts tests/gemini.test.ts tests/booking.test.ts tests/schema.test.ts tests/runtime.test.ts tests/poiUniqueness.test.ts tests/trip.test.ts tests/chatConsistency.test.ts",
    "seed": "tsx src/scripts/seedAppwrite.ts",
    "build:function": "esbuild functions/index.ts --bundle --platform=node --format=esm --packages=external --outfile=functions/dist/index.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "appwrite": "^28.1.0",
    "@google/genai": "^1.0.0",
    "framer-motion": "^12.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "react-leaflet": "^4.2.1",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/leaflet": "^1.9.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "dotenv": "^16.4.0",
    "tsx": "^4.19.0",
    "oxlint": "^1.81.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.0"
  }
}
